@model User
@{
    ViewData["Title"] = "Trang chủ ví";
    var transactions = ViewBag.Transactions as List<Transaction>;
    var monthlyExpense = (decimal)ViewBag.MonthlyExpense;
    var monthlyTxCount = (int)ViewBag.MonthlyTransactionCount;
    var linkedBankCount = (int)ViewBag.LinkedBankCount;
}

<section class="wallet-header">
    <div class="wallet-header-glow"></div>

    <div class="wallet-user">
        <div class="wallet-badges">
            <span class="wallet-label">
                <i class="fa-solid fa-shield-halved"></i>
                Ví đã được xác thực
            </span>

            @if (Model.Status == "Active")
            {
                <span class="badge badge-success">
                    <i class="fa-solid fa-circle-check"></i>
                    Ví đang hoạt động
                </span>
            }
            else
            {
                <span class="badge badge-danger">
                    <i class="fa-solid fa-lock"></i>
                    Ví đang bị khóa
                </span>
            }
        </div>

        <p>Xin chào,</p>
        <h1>@Model.FullName</h1>

        <div class="wallet-meta">
            <span class="wallet-id">
                <i class="fa-solid fa-phone"></i>
                @Model.Phone
            </span>

            <span class="wallet-id">
                <i class="fa-solid fa-calendar-check"></i>
                Thành viên từ @Model.CreatedAt.ToString("MM/yyyy")
            </span>
        </div>
    </div>

    <div class="balance-box">
        <span>Số dư khả dụng</span>
        <strong>@Model.Balance.ToString("N0") đ</strong>
        <small>
            <i class="fa-solid fa-lock"></i>
            Số dư được bảo mật
        </small>

        <a class="btn balance-cta" asp-action="Transfer">
            <i class="fa-solid fa-paper-plane"></i>
            Chuyển tiền ngay
        </a>
    </div>
</section>

<div class="stats-row">
    <div class="stat-card stat-accent">
        <div class="stat-card-top">
            <span>Chi tiêu tháng này</span>
            <span class="stat-icon stat-icon-accent">
                <i class="fa-solid fa-money-bill-transfer"></i>
            </span>
        </div>
        <strong>@monthlyExpense.ToString("N0") đ</strong>
        <small>Rút tiền, chuyển khoản &amp; hóa đơn</small>
    </div>

    <div class="stat-card">
        <div class="stat-card-top">
            <span>Giao dịch tháng này</span>
            <span class="stat-icon">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </span>
        </div>
        <strong>@monthlyTxCount</strong>
        <small>Giao dịch thành công</small>
    </div>

    <div class="stat-card">
        <div class="stat-card-top">
            <span>Ngân hàng liên kết</span>
            <span class="stat-icon">
                <i class="fa-solid fa-building-columns"></i>
            </span>
        </div>
        <strong>@linkedBankCount</strong>
        <small>
            <a asp-action="BankAccounts">Quản lý liên kết →</a>
        </small>
    </div>
</div>

<div class="page-heading">
    <h1>Tiện ích ví</h1>
    <p>Thực hiện các giao dịch nhanh chóng và an toàn.</p>
</div>

<div class="grid-actions">
    <a class="action-card" asp-action="Deposit">
        <span class="action-icon deposit-icon">
            <i class="fa-solid fa-circle-plus"></i>
        </span>

        <div>
            <h3>Nạp tiền</h3>
            <p>Nạp tiền vào ví để sử dụng các dịch vụ.</p>
        </div>

        <span class="action-arrow"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a class="action-card" asp-action="Withdraw">
        <span class="action-icon withdraw-icon">
            <i class="fa-solid fa-money-bill-transfer"></i>
        </span>

        <div>
            <h3>Rút tiền</h3>
            <p>Rút tiền từ ví về tài khoản của bạn.</p>
        </div>

        <span class="action-arrow"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a class="action-card" asp-action="Transfer">
        <span class="action-icon transfer-icon">
            <i class="fa-solid fa-paper-plane"></i>
        </span>

        <div>
            <h3>Chuyển tiền</h3>
            <p>Chuyển tiền nhanh qua số điện thoại.</p>
        </div>

        <span class="action-arrow"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a class="action-card" asp-action="PayBill">
        <span class="action-icon bill-icon">
            <i class="fa-solid fa-file-invoice-dollar"></i>
        </span>

        <div>
            <h3>Thanh toán hóa đơn</h3>
            <p>Thanh toán điện, nước và Internet.</p>
        </div>

        <span class="action-arrow"><i class="fa-solid fa-arrow-right"></i></span>
    </a>
    <a class="action-card" asp-action="TransactionStatus">
        <div class="action-icon transfer-icon">
            <i class="fa-solid fa-magnifying-glass-dollar"></i>
        </div>
        <h3>Tra cứu giao dịch</h3>
        <p>Kiểm tra trạng thái nạp/rút tiền</p>
    </a>
</div>

<div class="card">
    <div class="card-title">
        <div>
            <h2>Chi tiêu hàng tháng</h2>
            <p>Tổng tiền rút/chuyển/thanh toán hóa đơn trong 6 tháng gần nhất.</p>
        </div>

        <span class="chart-legend">
            <span class="legend-dot legend-dot-muted"></span> Các tháng trước
            <span class="legend-dot legend-dot-accent"></span> Tháng này
        </span>
    </div>

    <canvas id="spendingChart" height="90"></canvas>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    (function() {
        var canvasEl = document.getElementById('spendingChart');
        if (!canvasEl || typeof Chart === 'undefined') {
            console.error('Không thể tải thư viện Chart.js hoặc không tìm thấy canvas #spendingChart.');
            return;
        }
        var ctx = canvasEl.getContext('2d');
        var values = @Json.Serialize(ViewBag.SpendingChartValues);
        var barColors = values.map(function(_, index) {
            return index === values.length - 1 ? '#f59e0b' : '#0f9d76';
        });

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Json.Serialize(ViewBag.SpendingChartLabels),
                datasets: [{
                    label: 'Chi tiêu (đ)',
                    data: values,
                    backgroundColor: barColors,
                    borderRadius: 6,
                    maxBarThickness: 56
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + 'đ';
                            }
                        }
                    }
                }
            }
        });
    })();
</script>

<div class="card">
    <div class="card-title">
        <div>
            <h2>Giao dịch gần đây</h2>
            <p>Theo dõi các hoạt động mới nhất trong ví.</p>
        </div>

        <a class="btn btn-light" asp-action="History">
            Xem tất cả
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    @if (transactions != null && transactions.Any())
    {
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Loại giao dịch</th>
                        <th>Số tiền</th>
                        <th>Nội dung</th>
                        <th>Trạng thái</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in transactions)
                    {
                        var isIncome =
                            item.Type == "Nạp tiền" ||
                            item.ReceiverId == Model.UserId;

                        var statusBadge = item.Status switch
                        {
                            "Success" => "badge-success",
                            "Pending" => "badge-warning",
                            "Failed" => "badge-danger",
                            _ => "badge-info"
                        };

                        var typeIcon = item.Type switch
                        {
                            "Nạp tiền" => "fa-circle-plus",
                            "Withdraw" => "fa-money-bill-transfer",
                            "Transfer" => "fa-paper-plane",
                            "Bill" => "fa-file-invoice-dollar",
                            _ => "fa-arrow-right-arrow-left"
                        };

                        <tr>
                            <td>
                                <span class="tx-type">
                                    <span class="tx-type-icon @(isIncome ? "tx-type-icon-in" : "tx-type-icon-out")">
                                        <i class="fa-solid @typeIcon"></i>
                                    </span>
                                    <strong>@item.Type</strong>
                                </span>
                            </td>

                            <td class="@(isIncome ? "amount-positive" : "amount-negative")">
                                @(isIncome ? "+" : "-")@item.Amount.ToString("N0") đ
                            </td>

                            <td>@item.Description</td>

                            <td>
                                <span class="badge @statusBadge">
                                    @item.Status
                                </span>
                            </td>

                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-receipt"></i>
            <h3>Chưa có giao dịch</h3>
            <p>Các giao dịch mới sẽ được hiển thị tại đây.</p>
        </div>
    }
</div>