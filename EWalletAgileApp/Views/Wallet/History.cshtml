@model List<Transaction>
@{
    ViewData["Title"] = "Lịch sử giao dịch";
    @if (Context.Session.GetString("Role") == "Admin" ||
     Context.Session.GetString("Role") == "Staff")
    {
        <div style="margin-bottom: 20px; padding: 15px; border: 1px dashed #999;">
            <strong>TEST US017 - Hoàn tiền giao dịch lỗi</strong>

            <form asp-controller="Wallet"
                  asp-action="CreateTestFailedTransaction"
                  method="post"
                  style="margin-top: 10px;">

                @Html.AntiForgeryToken()

                <input type="number"
                       name="amount"
                       value="100000"
                       min="1000"
                       step="1000" />

                <button type="submit">
                    Tạo giao dịch lỗi TEST
                </button>

            </form>
        </div>
    }
}
<div class="card">
    <h1>Lịch sử giao dịch</h1>
    <table>
        <thead>
        <tr>
            <th>Mã GD</th>
            <th>Loại</th>
            <th>Người gửi</th>
            <th>Người nhận</th>
            <th>Số tiền</th>
            <th>Nội dung</th>
            <th>Trạng thái</th>
            <th>Ngày</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    <td>
                        <span class="transaction-code">
                            @item.TransactionCode
                        </span>
                    </td>
                    <td>
                        @if (item.Type == "Deposit")
                        {
                            <span>Nạp tiền</span>
                        }
                        else if (item.Type == "Withdraw")
                        {
                            <span>Rút tiền</span>
                        }
                        else if (item.Type == "Transfer")
                        {
                            <span>Chuyển tiền</span>
                        }
                        else if (item.Type == "Bill")
                        {
                            <span>Thanh toán hóa đơn</span>
                        }
                        else if (item.Type == "Refund")
                        {
                            <span>Hoàn tiền</span>
                        }
                        else
                        {
                            @item.Type
                        }
                    </td>
                <td>@item.Sender?.FullName</td>
                <td>@item.Receiver?.FullName</td>
                <td>@item.Amount.ToString("N0") đ</td>
                <td>@item.Description</td>
                <td>@item.Status</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
