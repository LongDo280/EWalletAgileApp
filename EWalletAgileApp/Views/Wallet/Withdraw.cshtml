@model User

@{
    ViewData["Title"] = "Rút tiền";

    var bankAccounts =
        ViewBag.BankAccounts as List<BankAccount>
        ?? new List<BankAccount>();
}

<div class="card form-card">

    <div class="form-icon">
        <i class="fa-solid fa-money-bill-transfer"></i>
    </div>

    <h1>Rút tiền khỏi ví</h1>

    <p class="form-description">
        Số dư hiện tại:
        <strong>@Model.Balance.ToString("N0") đ</strong>
    </p>

    <form asp-action="Withdraw" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        @if (!bankAccounts.Any())
        {
            <div class="empty-state">

                <i class="fa-solid fa-building-columns"></i>

                <h3>Chưa có tài khoản ngân hàng</h3>

                <p>
                    Bạn cần liên kết tài khoản ngân hàng
                    trước khi rút tiền.
                </p>

                <a asp-action="LinkBank"
                   class="btn btn-light">

                    <i class="fa-solid fa-link"></i>
                    Liên kết ngân hàng

                </a>

            </div>
        }
        else
        {
            <label>
                <i class="fa-solid fa-building-columns"></i>
                Tài khoản nhận tiền
            </label>

            <select name="bankAccountId" required>

                <option value="">
                    -- Chọn tài khoản ngân hàng --
                </option>

                @foreach (var bank in bankAccounts)
                {
                    var lastFour =
                        bank.AccountNumber.Length >= 4
                            ? bank.AccountNumber[^4..]
                            : bank.AccountNumber;

                    <option value="@bank.BankAccountId">
                        @bank.BankName - ****@lastFour
                    </option>
                }

            </select>

            <label>
                <i class="fa-solid fa-money-bill"></i>
                Số tiền
            </label>

            <input name="amount"
                   type="number"
                   min="1000"
                   step="1000"
                   placeholder="Ví dụ: 100000"
                   required />

            <label>
                <i class="fa-solid fa-lock"></i>
                Mã PIN
            </label>

            <input name="pinCode"
                   type="password"
                   maxlength="6"
                   placeholder="Nhập mã PIN"
                   required />

            <button class="btn-full"
                    type="submit">

                <i class="fa-solid fa-money-bill-transfer"></i>

                Xác nhận rút tiền

            </button>
        }
    </form>
</div>