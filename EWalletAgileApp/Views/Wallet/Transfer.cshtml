@model TransferViewModel

@{
    ViewData["Title"] = "Chuyển tiền";
}

<div class="card form-card">

    <div class="form-icon">
        <i class="fa-solid fa-paper-plane"></i>
    </div>

    <h1>Chuyển tiền</h1>

    <p class="form-description">
        Chuyển tiền nhanh chóng đến người dùng khác bằng số điện thoại.
    </p>

    <form asp-action="Transfer" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <label>
            <i class="fa-solid fa-phone"></i>
            Số điện thoại người nhận
        </label>

        <input asp-for="ReceiverPhone"
               placeholder="0900000002"
               autocomplete="off" />

        <span asp-validation-for="ReceiverPhone"
              class="text-danger"></span>

        <label>
            <i class="fa-solid fa-money-bill"></i>
            Số tiền
        </label>

        <input asp-for="Amount"
               type="number"
               min="1000"
               step="1000"
               placeholder="Ví dụ: 500000" />

        <span asp-validation-for="Amount"
              class="text-danger"></span>

        <label>
            <i class="fa-solid fa-message"></i>
            Nội dung chuyển tiền
        </label>

        <input asp-for="Description"
               placeholder="Ví dụ: Chuyển tiền mua sách" />

        <label>
            <i class="fa-solid fa-lock"></i>
            Mã PIN
        </label>

        <input asp-for="PinCode"
               type="password"
               maxlength="6"
               placeholder="Nhập mã PIN" />

        <span asp-validation-for="PinCode"
              class="text-danger"></span>

        <button class="btn-full"
                type="submit">

            <i class="fa-solid fa-paper-plane"></i>

            Xác nhận chuyển tiền

        </button>

    </form>
</div>