@model TransferViewModel

@{
    ViewData["Title"] = "Chuyển tiền";
    var currentBalance = (decimal)(ViewBag.CurrentBalance ?? 0m);
}

<div class="page-heading">
    <h1>Chuyển tiền</h1>
    <p>Chọn số tiền, nhập người nhận và xem trước biên nhận trước khi xác nhận.</p>
</div>

<form asp-action="Transfer" method="post" id="transferForm">

    @Html.AntiForgeryToken()

    <div class="split-layout">
        <div class="card">
            <div class="panel-title">
                <i class="fa-solid fa-user"></i>
                Người nhận
            </div>

            <div asp-validation-summary="All" class="text-danger"></div>

            <label class="form-label">
                <i class="fa-solid fa-phone"></i>
                Số điện thoại người nhận
            </label>

            <input asp-for="ReceiverPhone"
                   id="receiverInput"
                   placeholder="0900000002"
                   autocomplete="off" />

            <span asp-validation-for="ReceiverPhone" class="text-danger"></span>

            <label class="form-label" style="margin-top: 22px;">
                <i class="fa-solid fa-money-bill"></i>
                Số tiền cần chuyển
            </label>

            <div class="amount-input-lg">
                <input id="displayAmount" type="text" inputmode="numeric" placeholder="0" />
                <span>đ</span>
            </div>

            <input asp-for="Amount" id="amountInput" type="hidden" />

            <div class="quick-chips">
                <button type="button" class="chip-btn" data-value="100000">100.000 đ</button>
                <button type="button" class="chip-btn" data-value="200000">200.000 đ</button>
                <button type="button" class="chip-btn" data-value="500000">500.000 đ</button>
                <button type="button" class="chip-btn" data-value="1000000">1.000.000 đ</button>
            </div>

            <span asp-validation-for="Amount" class="text-danger"></span>

            <label class="form-label">
                <i class="fa-solid fa-message"></i>
                Nội dung chuyển tiền
            </label>

            <input asp-for="Description"
                   id="descriptionInput"
                   placeholder="Ví dụ: Chuyển tiền mua sách" />

            <label class="form-label">
                <i class="fa-solid fa-lock"></i>
                Mã PIN
            </label>

            <input asp-for="PinCode"
                   type="password"
                   maxlength="6"
                   placeholder="Nhập mã PIN" />

            <span asp-validation-for="PinCode" class="text-danger"></span>
        </div>

        <div class="card summary-panel">
            <div class="panel-title">
                <i class="fa-solid fa-receipt"></i>
                Biên nhận
            </div>

            <div class="summary-list">
                <div class="summary-row">
                    <span>Người nhận</span>
                    <strong id="sumPhone">Chưa nhập</strong>
                </div>

                <div class="summary-row">
                    <span>Số tiền chuyển</span>
                    <strong id="sumAmount">0 đ</strong>
                </div>

                <div class="summary-row">
                    <span>Nội dung</span>
                    <strong id="sumDesc">--</strong>
                </div>

                <div class="summary-row">
                    <span>Phí giao dịch</span>
                    <strong>Miễn phí</strong>
                </div>
            </div>

            <div class="summary-list summary-list-tight">
                <div class="summary-row">
                    <span>Số dư hiện tại</span>
                    <strong>@currentBalance.ToString("N0") đ</strong>
                </div>

                <div class="summary-row summary-highlight">
                    <span>Số dư dự kiến sau khi chuyển</span>
                    <strong id="sumAfter">@currentBalance.ToString("N0") đ</strong>
                </div>
            </div>

            <button class="btn-full" type="submit" form="transferForm">
                <i class="fa-solid fa-paper-plane"></i>
                Xác nhận chuyển tiền
            </button>
        </div>
    </div>
</form>

<script>
    (function () {
        var currentBalance = @currentBalance.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);

        var displayInput = document.getElementById('displayAmount');
        var amountInput = document.getElementById('amountInput');
        var receiverInput = document.getElementById('receiverInput');
        var descriptionInput = document.getElementById('descriptionInput');
        var chips = document.querySelectorAll('.chip-btn');

        var sumPhone = document.getElementById('sumPhone');
        var sumAmount = document.getElementById('sumAmount');
        var sumDesc = document.getElementById('sumDesc');
        var sumAfter = document.getElementById('sumAfter');

        function formatCurrency(val) {
            if (!val) return '';
            return parseInt(val, 10).toLocaleString('vi-VN');
        }

        function updateSummary() {
            var amount = parseInt(amountInput.value || '0', 10) || 0;
            var phone = receiverInput.value.trim();
            var desc = descriptionInput.value.trim();

            sumPhone.textContent = phone || 'Chưa nhập';
            sumAmount.textContent = amount.toLocaleString('vi-VN') + ' đ';
            sumDesc.textContent = desc || '--';
            sumAfter.textContent = Math.max(currentBalance - amount, 0).toLocaleString('vi-VN') + ' đ';
        }

        function clearActiveChips() {
            chips.forEach(function (c) { c.classList.remove('active'); });
        }

        displayInput.addEventListener('input', function () {
            var rawValue = this.value.replace(/\D/g, '');
            amountInput.value = rawValue;
            this.value = formatCurrency(rawValue);
            clearActiveChips();
            updateSummary();
        });

        chips.forEach(function (chip) {
            chip.addEventListener('click', function () {
                clearActiveChips();
                this.classList.add('active');

                var val = this.getAttribute('data-value');
                amountInput.value = val;
                displayInput.value = formatCurrency(val);
                updateSummary();
            });
        });

        receiverInput.addEventListener('input', updateSummary);
        descriptionInput.addEventListener('input', updateSummary);

        updateSummary();
    })();
</script>