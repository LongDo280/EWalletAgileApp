@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="card auth-card">
    <div class="form-icon">
        <i class="fa-solid fa-lock-open"></i>
    </div>

    <h1>Đặt lại mật khẩu</h1>

    @if (TempData["DemoOtp"] != null)
    {
        <div style="background:#fff7ed; color:#92400e; border:1px solid #fed7aa; font-size:13px;
            padding:10px 14px; border-radius:8px; text-align:center; margin-bottom:18px;">
            Demo: mã OTP của bạn là <strong>@TempData["DemoOtp"]</strong>
            <br />(hệ thống chưa tích hợp gửi Email/SMS thật nên hiển thị trực tiếp để kiểm thử)
        </div>
    }

    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="Account" />

        <label><i class="fa-solid fa-shield-halved"></i> Mã OTP</label>
        <input asp-for="Otp" placeholder="Nhập mã OTP 6 số" />

        <label><i class="fa-solid fa-lock"></i> Mật khẩu mới</label>
        <input asp-for="NewPassword" type="password" placeholder="Nhập mật khẩu mới" />

        <label><i class="fa-solid fa-lock"></i> Xác nhận mật khẩu mới</label>
        <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu mới" />

        <button class="btn-full" type="submit">
            <i class="fa-solid fa-check"></i>
            Đặt lại mật khẩu
        </button>
    </form>

    <div class="auth-footer">
        <p>Chưa nhận được mã? <a asp-action="ForgotPassword">Gửi lại</a></p>
    </div>
</div>