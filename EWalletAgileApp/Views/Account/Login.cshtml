@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="card auth-card">
    <div class="form-icon">
        <i class="fa-solid fa-wallet"></i>
    </div>

    <h1>Chào mừng trở lại</h1>

    <p class="form-description">
        Đăng nhập để quản lý số dư và thực hiện giao dịch.
    </p>

    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <label>
            <i class="fa-solid fa-user"></i>
            Email hoặc số điện thoại
        </label>

        <input asp-for="Account"
               placeholder="user1@gmail.com hoặc 0900000001" />

        <label>
            <i class="fa-solid fa-lock"></i>
            Mật khẩu
        </label>

        <input asp-for="Password"
               type="password"
               placeholder="Nhập mật khẩu" />
        <p class="hint" style="text-align:right; margin-top:6px;">
            <a asp-action="ForgotPassword">Quên mật khẩu?</a>
        </p>
        <button class="btn-full" type="submit">
            <i class="fa-solid fa-right-to-bracket"></i>
            Đăng nhập
        </button>
    </form>

    <div class="auth-footer">
        <p>
            Chưa có tài khoản?
            <a asp-action="Register">Đăng ký ngay</a>
        </p>

        <p class="hint">
            Tài khoản mẫu: user1@gmail.com / 123456
        </p>
    </div>
</div>