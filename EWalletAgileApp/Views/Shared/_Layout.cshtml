<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - E-Wallet Agile</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Wallet" asp-action="Index">
                <span class="brand-icon">
                    <i class="fa-solid fa-wallet"></i>
                </span>

                <span>
                    <strong>E-Wallet</strong>
                    <small>Thanh toán thông minh</small>
                </span>
            </a>

            <nav class="main-nav">
                <a asp-controller="Wallet" asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    Ví của tôi
                </a>

                <a asp-controller="Wallet" asp-action="History">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Lịch sử
                </a>

                <a asp-controller="Wallet" asp-action="BankAccounts">
                    <i class="fa-solid fa-building-columns"></i>
                    Ngân hàng liên kết
                </a>

                <a asp-controller="Account" asp-action="Profile">
                    <i class="fa-solid fa-user"></i>
                    Hồ sơ
                </a>

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-user-shield"></i>
                        Admin
                    </a>
                }

                <a class="logout-link"
                   asp-controller="Account"
                   asp-action="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Đăng xuất
                </a>
            </nav>
        </div>
    </header>

    <main class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert success">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <p>© 2026 E-Wallet Agile. Hệ thống quản lý ví điện tử.</p>
    </footer>
</body>
</html>